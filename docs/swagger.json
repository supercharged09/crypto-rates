{
    "swagger": "2.0",
    "info": {
        "description": "API для отслеживания курсов криптовалют",
        "title": "Crypto Rates API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/chart/{cryptocurrency}": {
            "get": {
                "description": "Возвращает интерактивный HTML-график цены монеты за последние 24 часа",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "chart"
                ],
                "summary": "График цены за 24 часа",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID монеты",
                        "name": "cryptocurrency",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML график",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/rates": {
            "get": {
                "description": "Возвращает текущие курсы, min/max за 24ч и изменение за час для всех отслеживаемых монет",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rates"
                ],
                "summary": "Получить все курсы",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/rates/{cryptocurrency}": {
            "get": {
                "description": "Возвращает текущий курс, min/max за 24ч и изменение за час для указанной монеты",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rates"
                ],
                "summary": "Получить курс монеты",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID монеты (bitcoin, ethereum, btc, eth и т.д.)",
                        "name": "cryptocurrency",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.RateStats"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.RateStats": {
            "type": "object",
            "properties": {
                "change_percent_1h": {
                    "type": "number"
                },
                "cryptocurrency": {
                    "type": "string"
                },
                "current_price": {
                    "type": "number"
                },
                "last_updated": {
                    "type": "string"
                },
                "max_price_24h": {
                    "type": "number"
                },
                "min_price_24h": {
                    "type": "number"
                }
            }
        }
    }
}